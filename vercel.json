{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/data/history/(\\d{4}-\\d{2}-\\d{2})\\.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] },
    { "source": "/((?!data/history/\\d).*)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
